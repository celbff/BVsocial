# SUPABASE - STORAGE (ARMAZENAMENTO DE ARQUIVOS)
VITE_STORAGE_BUCKET=posts-media
VITE_STORAGE_URL=https://xdfvzhynofprwystnyhf.supabase.co/storage/v1
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# CONFIGURAÇÕES DE UPLOAD
VITE_MAX_AVATAR_SIZE=2097152
VITE_MAX_POST_IMAGES=5
VITE_IMAGE_COMPRESSION_QUALITY=80

# MAPA E LOCALIZAÇÃO (SE USAR)
VITE_DEFAULT_LATITUDE=-21.7941
VITE_DEFAULT_LONGITUDE=-48.1749
VITE_DEFAULT_CITY=Araraquara
VITE_DEFAULT_STATE=SP

# CONFIGURAÇÕES DE PAGINAÇÃO
VITE_POSTS_PER_PAGE=10
VITE_COMMENTS_PER_PAGE=5
VITE_NOTIFICATIONS_PER_PAGE=20

# TEMPO DE CACHE (em segundos)
VITE_CACHE_TIME_POSTS=300
VITE_CACHE_TIME_USER=600
VITE_CACHE_TIME_NOTIFICATIONS=60

# FEATURE FLAGS (ativar/desativar funcionalidades)
VITE_ENABLE_STORIES=true
VITE_ENABLE_MESSAGES=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_MAPS=true
VITE_ENABLE_DARK_MODE=false

# CONFIGURAÇÕES DE SEGURANÇA
VITE_SESSION_TIMEOUT=3600
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_PASSWORD_MIN_LENGTH=6

# ANALYTICS (opcional)
VITE_GA_MEASUREMENT_ID=
VITE_HOTJAR_ID=

# DEBUG E DESENVOLVIMENTO
VITE_DEBUG_MODE=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_API_LOGGING=true
VITE_SHOW_ERROR_DETAILS=true
